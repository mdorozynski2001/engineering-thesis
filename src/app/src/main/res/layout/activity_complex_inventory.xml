<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ComplexInventory">

  <TextView
      android:id="@+id/productNameView"
      android:layout_width="wrap_content"
      android:layout_height="0dp"
      android:text="@string/no_product"
      android:textSize="25sp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toTopOf="@id/hor_guideline_1"
      app:layout_constraintLeft_toLeftOf="parent"
      app:layout_constraintRight_toRightOf="parent"
      />

  <TextView
      android:id="@+id/productBarcodeView"
      android:layout_width="wrap_content"
      android:layout_height="0dp"
      android:text="@string/no_barcode"
      android:textSize="25sp"
      app:layout_constraintTop_toTopOf="@id/hor_guideline_1"
      app:layout_constraintBottom_toTopOf="@id/hor_guideline_2"
      app:layout_constraintLeft_toLeftOf="parent"
      app:layout_constraintRight_toRightOf="parent"
      />


  <SurfaceView
      android:id="@+id/surfaceView"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginLeft="5dp"
      android:layout_marginRight="5dp"
      android:layout_marginBottom="5dp"
      android:layout_marginTop="5dp"
      app:layout_constraintLeft_toLeftOf="@id/ver_guideline_1"
      app:layout_constraintRight_toRightOf="@id/ver_guideline_5"
      app:layout_constraintTop_toTopOf="@id/hor_guideline_2"
      app:layout_constraintBottom_toTopOf="@id/hor_guideline_3"/>

  <Button
      android:id="@+id/button_previous_product"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:text="@string/previous"
      android:layout_marginLeft="5dp"
      android:layout_marginRight="5dp"
      android:layout_marginBottom="5dp"
      android:layout_marginTop="5dp"
      app:layout_constraintLeft_toLeftOf="parent"
      app:layout_constraintRight_toRightOf="@id/ver_guideline_2"
      app:layout_constraintTop_toTopOf="@id/hor_guideline_3"
      app:layout_constraintBottom_toTopOf="@id/hor_guideline_4" />

  <Button
      android:id="@+id/button_scan_product"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:text="@string/scan"
      android:layout_marginLeft="5dp"
      android:layout_marginRight="5dp"
      android:layout_marginBottom="5dp"
      android:layout_marginTop="5dp"
      app:layout_constraintLeft_toLeftOf="@id/ver_guideline_2"
      app:layout_constraintRight_toRightOf="@id/ver_guideline_4"
      app:layout_constraintTop_toTopOf="@id/hor_guideline_3"
      app:layout_constraintBottom_toTopOf="@id/hor_guideline_4" />

  <Button
      android:id="@+id/button_next_product"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:text="@string/next"
      android:layout_marginLeft="5dp"
      android:layout_marginRight="5dp"
      android:layout_marginBottom="5dp"
      android:layout_marginTop="5dp"
      app:layout_constraintLeft_toLeftOf="@id/ver_guideline_4"
      app:layout_constraintRight_toRightOf="parent"
      app:layout_constraintTop_toTopOf="@id/hor_guideline_3"
      app:layout_constraintBottom_toTopOf="@id/hor_guideline_4" />

  <TextView
      android:id="@+id/textView_db_amount"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/amount_in_db"
      android:textSize="15sp"
      android:layout_marginLeft="5dp"
      android:layout_marginRight="5dp"
      android:layout_marginBottom="5dp"
      android:layout_marginTop="5dp"
      app:layout_constraintLeft_toLeftOf="@id/ver_guideline_1"
      app:layout_constraintRight_toRightOf="@id/ver_guideline_3"
      app:layout_constraintTop_toTopOf="@id/hor_guideline_4"
      app:layout_constraintBottom_toTopOf="@id/hor_guideline_5" />

  <TextView
      android:id="@+id/textView_real_amount"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/real_amount"
      android:textSize="15sp"
      android:layout_marginLeft="5dp"
      android:layout_marginRight="5dp"
      android:layout_marginBottom="5dp"
      android:layout_marginTop="5dp"
      app:layout_constraintLeft_toLeftOf="@id/ver_guideline_3"
      app:layout_constraintRight_toRightOf="@id/ver_guideline_5"
      app:layout_constraintTop_toTopOf="@id/hor_guideline_4"
      app:layout_constraintBottom_toTopOf="@id/hor_guideline_5" />

  <TextView
      android:id="@+id/db_amount_info"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/x"
      android:textSize="15sp"
      android:layout_marginLeft="5dp"
      android:layout_marginRight="5dp"
      android:layout_marginBottom="5dp"
      android:layout_marginTop="5dp"
      app:layout_constraintLeft_toLeftOf="@id/ver_guideline_1"
      app:layout_constraintRight_toRightOf="@id/ver_guideline_3"
      app:layout_constraintTop_toTopOf="@id/hor_guideline_5"
      app:layout_constraintBottom_toTopOf="@id/hor_guideline_6" />

  <EditText
      android:id="@+id/amount_real"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginLeft="5dp"
      android:layout_marginTop="5dp"
      android:layout_marginRight="5dp"
      android:autofillHints="@string/x"
      android:hint="@string/x"
      android:inputType="number"
      android:textSize="15sp"
      android:enabled="false"
      app:layout_constraintBottom_toTopOf="@id/hor_guideline_6"
      app:layout_constraintLeft_toLeftOf="@id/ver_guideline_3"
      app:layout_constraintRight_toRightOf="@id/ver_guideline_5"
      app:layout_constraintTop_toTopOf="@id/hor_guideline_5"
      app:layout_constraintVertical_bias="0.0"
      tools:ignore="TouchTargetSizeCheck" />



  <Button
      android:id="@+id/apply_button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/apply_changes"
      android:textSize="15sp"
      android:layout_marginLeft="5dp"
      android:layout_marginTop="5dp"
      android:layout_marginRight="5dp"
      android:enabled="false"
      app:layout_constraintLeft_toLeftOf="@id/ver_guideline_2"
      app:layout_constraintRight_toRightOf="@id/ver_guideline_4"
      app:layout_constraintTop_toTopOf="@id/hor_guideline_6" />




  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/hor_guideline_1"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.05" />

  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/hor_guideline_2"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.1" />

  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/hor_guideline_3"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.5" />

  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/hor_guideline_4"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.6" />

  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/hor_guideline_5"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.64" />

  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/hor_guideline_6"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.7" />

  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/ver_guideline_1"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      app:layout_constraintGuide_percent="0.1" />

  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/ver_guideline_2"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      app:layout_constraintGuide_percent="0.33" />

  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/ver_guideline_3"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      app:layout_constraintGuide_percent="0.5" />

  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/ver_guideline_4"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      app:layout_constraintGuide_percent="0.66" />

  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/ver_guideline_5"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      app:layout_constraintGuide_percent="0.9" />

</androidx.constraintlayout.widget.ConstraintLayout>